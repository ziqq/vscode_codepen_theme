{
  "information_for_contributors": [
    "This file provides just syntax highlighting support",
    "Based on various just grammar sources"
  ],
  "name": "just",
  "scopeName": "source.just",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#settings"
    },
    {
      "include": "#assignments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#recipes"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.shebang.just",
          "match": "^#!.*$"
        },
        {
          "name": "comment.line.number-sign.just",
          "match": "#.*$"
        }
      ]
    },
    "settings": {
      "match": "^(set)(\\s+)([A-Za-z_][A-Za-z0-9_-]*)(?:\\s*(:=))?",
      "captures": {
        "1": {
          "name": "keyword.other.reserved.just"
        },
        "3": {
          "name": "variable.other.just"
        },
        "4": {
          "name": "keyword.operator.assignment.just"
        }
      }
    },
    "assignments": {
      "match": "^(?:(export|unexport)\\s+)?([A-Za-z_][A-Za-z0-9_-]*)(\\s*)(:=)",
      "captures": {
        "1": {
          "name": "keyword.other.reserved.just"
        },
        "2": {
          "name": "variable.other.just"
        },
        "4": {
          "name": "keyword.operator.assignment.just"
        }
      }
    },
    "directives": {
      "patterns": [
        {
          "match": "^(alias)(\\s+)([A-Za-z_][A-Za-z0-9_-]*)(\\s*)(:=)(\\s*)([A-Za-z_][A-Za-z0-9_-]*)",
          "captures": {
            "1": {
              "name": "keyword.other.reserved.just"
            },
            "3": {
              "name": "variable.other.just"
            },
            "5": {
              "name": "keyword.operator.assignment.just"
            },
            "7": {
              "name": "entity.name.function.target.just"
            }
          }
        },
        {
          "match": "^(import|mod)(\\?)(?=\\s)",
          "captures": {
            "1": {
              "name": "keyword.other.reserved.just"
            },
            "2": {
              "name": "keyword.operator.optional.just"
            }
          }
        }
      ]
    },
    "recipes": {
      "match": "^(?:\\[[^]\\n]+\\]\\s*)*(@?)([A-Za-z_][A-Za-z0-9_-]*)(?=[^#\\n]*:(?!=))",
      "captures": {
        "1": {
          "name": "keyword.operator.quiet.just"
        },
        "2": {
          "name": "entity.name.function.target.just"
        }
      }
    },
    "interpolation": {
      "begin": "{{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.just"
        }
      },
      "end": "}}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.just"
        }
      },
      "name": "meta.interpolation.just",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#operators"
        },
        {
          "name": "support.function.builtin.just",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.just",
          "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.just",
          "begin": "\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\""
        },
        {
          "name": "string.quoted.triple.single.just",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.just",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.just",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.just",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "string.interpolated.backtick.just",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.just",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.numeric.just",
          "match": "(?<![A-Za-z0-9_-])(?:\\d+(?:\\.\\d+)?|\\.\\d+)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.control.conditional.just",
          "match": "\\b(?:if|else)\\b"
        },
        {
          "name": "keyword.operator.just",
          "match": "\\|\\||&&|==|!=|=~|!~|:=|[+*/%]"
        }
      ]
    }
  }
}

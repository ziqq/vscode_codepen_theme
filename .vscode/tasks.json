{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "codepen-theme",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^CODEPEN_THEME_BUILD_START$",
          "endsPattern": "^CODEPEN_THEME_BUILD_READY .+$"
        }
      },
      "label": "npm: start",
      "detail": "Regenerate the CodePen theme when source files change"
    },
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [],
      "label": "npm: build",
      "detail": "Generate themes/codepen-theme.json from src"
    },
    {
      "label": "preview: prepare",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/prepare-preview.mjs",
        "--vscode-executable",
        "${execPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Create the isolated preview profile and provider links"
    },
    {
      "label": "preview: launch",
      "dependsOrder": "sequence",
      "dependsOn": [
        "npm: build",
        "preview: prepare",
        "npm: start"
      ],
      "problemMatcher": [],
      "detail": "Build, prepare the isolated profile, and start the theme watcher"
    },
    {
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": [],
      "label": "npm: test",
      "detail": "Validate theme, providers, visual baselines, and release metadata"
    },
    {
      "type": "npm",
      "script": "visual:update",
      "problemMatcher": [],
      "label": "npm: visual:update",
      "detail": "Accept reviewed compatibility visual changes"
    }
  ]
}

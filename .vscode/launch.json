{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Samples",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Samples Without Build",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples"
      ]
    }
  ]
}

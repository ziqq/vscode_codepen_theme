{
    "name": "codepen-theme-original",
    "displayName": "CodePen Theme Original",
    "description": "Custom theme for Visual Studio Code inspired by the codepen.io online editor theme. Compatible with .HTML, .CSS, .JS, .TS, .JSX, .TSX, .DART, .GO, .PY and other formats. Made with 🖤 by ziqq.",
    "icon": "assets/logo.png",
    "version": "0.10.2",
    "engines": {
        "vscode": "^1.0.0"
    },
    "license": "Apache-2.0",
    "publisher": "ziqq",
    "author": {
        "name": "Anton Ustinoff"
    },
    "homepage": "https://github.com/ziqq/vscode_codepen_theme",
    "repository": {
        "type": "git",
        "url": "https://github.com/ziqq/vscode_codepen_theme"
    },
    "bugs": {
        "email": "a.a.ustinoff@gmail.com",
        "url": "https://github.com/ziqq/vscode_codepen_theme/issues"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "VSCode",
        "Themes"
    ],
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "contributes": {
        "languages": [
            {
                "id": "dart",
                "aliases": [
                    "Dart",
                    "dart"
                ],
                "extensions": [
                    ".dart"
                ]
            },
            {
                "id": "go",
                "aliases": [
                    "Go",
                    "go"
                ],
                "extensions": [
                    ".go"
                ]
            },
            {
                "id": "html",
                "aliases": [
                    "Html",
                    "html"
                ],
                "extensions": [
                    ".html",
                    ".jade",
                    ".nunjucks"
                ]
            },
            {
                "id": "python",
                "aliases": [
                    "Python",
                    "python"
                ],
                "extensions": [
                    ".py"
                ]
            },
            {
                "id": "sass",
                "aliases": [
                    "Sass",
                    "sass-indented"
                ],
                "extensions": [
                    ".sass",
                    ".sass.erb"
                ],
                "configuration": "./sass.configuration.json"
            },
            {
                "id": "scss",
                "aliases": [
                    "Scss",
                    "scss-indented"
                ],
                "extensions": [
                    ".scss",
                    ".scss.erb"
                ],
                "configuration": "./scss.configuration.json"
            },
            {
                "id": "svelte",
                "aliases": [
                    "Svelte",
                    "svelte"
                ],
                "extensions": [
                    ".svelte"
                ]
            },
            {
                "id": "sql",
                "aliases": [
                    "Sql",
                    "sql",
                    "Drift",
                    "drift"
                ],
                "extensions": [
                    ".sql",
                    ".drift"
                ]
            },
            {
                "id": "vue",
                "aliases": [
                    "Vue",
                    "vue"
                ],
                "extensions": [
                    ".vue"
                ]
            }
        ],
        "grammars": [
            {
                "language": "sass",
                "scopeName": "source.css.sass",
                "path": "./syntaxes/sass.tmLanguage.json"
            },
            {
                "language": "scss",
                "scopeName": "source.css.scss",
                "path": "./syntaxes/scss.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "CodePen Theme Original",
                "uiTheme": "vs-dark",
                "path": "./themes/codepen-theme.json"
            }
        ]
    },
    "scripts": {
        "start": "code . --extensionDevelopmentPath=. --disable-extensions",
        "deploy": "vsce publish"
    }
}
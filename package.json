{
    "name": "codepen-theme-original",
    "displayName": "CodePen Theme Original",
    "description": "A custom theme for Visual Studio Code inspired by the codepen.io online editor theme. Compatible with .HTML, .CSS, .JS, .TS, .JSX, .TSX, .DART, .GO, .PY and other formats. Made with 🖤 by ziqq.",
    "icon": "assets/logo.png",
    "version": "0.10.0",
    "engines": {
        "vscode": "^1.0.0"
    },
    "license": "Apache-2.0",
    "publisher": "ziqq",
    "author": {
        "name": "Anton Ustinoff"
    },
    "homepage": "https://github.com/ziqq/vscode_codepen_theme",
    "repository": {
        "type": "git",
        "url": "https://github.com/ziqq/vscode_codepen_theme"
    },
    "bugs": {
        "email": "a.a.ustinoff@gmail.com",
        "url": "https://github.com/ziqq/vscode_codepen_theme/issues"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "VSCode",
        "Themes"
    ],
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "contributes": {
        "languages": [
            {
                "id": "sass",
                "aliases": [
                    "Sass",
                    "sass-indented"
                ],
                "extensions": [
                    ".sass",
                    ".sass.erb"
                ],
                "configuration": "./sass.configuration.json"
            },
            {
                "id": "sass.hover",
                "extensions": [
                    ".sass.hover"
                ],
                "configuration": "./sass.configuration.json"
            },
            {
                "id": "vue",
                "aliases": [
                    "Vue",
                    "vue"
                ],
                "extensions": [
                    ".vue"
                ]
            },
            {
                "id": "solid",
                "aliases": [
                    "Solid",
                    "solid"
                ],
                "extensions": [
                    ".js",
                    ".jsx",
                    ".ts",
                    ".tsx"
                ]
            },
            {
                "id": "svelte",
                "aliases": [
                    "Svelte",
                    "svelte"
                ],
                "extensions": [
                    ".svelte"
                ]
            }
        ],
        "grammars": [
            {
                "language": "sass",
                "scopeName": "source.sass",
                "path": "./syntaxes/sass.tmLanguage.json"
            },
            {
                "language": "sass.hover",
                "scopeName": "source.sass.hover",
                "path": "./syntaxes/sass.hover.highlighting.json"
            }
        ],
        "themes": [
            {
                "label": "CodePen Theme Original",
                "uiTheme": "vs-dark",
                "path": "./themes/codepen-theme.json"
            }
        ]
    },
    "scripts": {
        "start": "code . --extensionDevelopmentPath=.",
        "deploy": "vsce publish"
    }
}
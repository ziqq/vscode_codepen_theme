# CodePen Theme sample environment. Values are intentionally non-secret.
APP_NAME="CodePen Theme Original"
THEME_MODE=dark
ENABLE_PREVIEW=true
ACCENT_COLOR='#96b38a'
THEME_BACKGROUND=#1d1e22
THEME_FONT="SFMono-Regular, Consolas, monospace"
THEME_PREVIEW_URL=https://example.test/themes/codepen
THEME_FEATURES="providers,screenshots,marketplace-drift"

# This interpolation is representative only; no runtime expands it here.
THEME_LABEL="${APP_NAME} (${THEME_MODE})"
